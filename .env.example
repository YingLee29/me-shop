# ─────────────────────────────────────────────────────
# 🌾 NôngSản – Environment Variables
# Sao chép file này thành .env và điền giá trị thực
# cp .env.example .env
# ─────────────────────────────────────────────────────

# ── APP ──
APP_NAME="NôngSản Shop"
APP_ENV=local
APP_DEBUG=true

# ── DATABASE ──
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=nongsan_db
DB_USERNAME=nongsan_user
DB_PASSWORD=nongsan_pass

# ── NEXT.JS ──
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_NAME="NôngSản Shop"
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# ── PORTS (thay đổi nếu bị conflict) ──
# Nginx:    80
# MySQL:    3306
# Redis:    6380 (host) → 6379 (container)
# Frontend: 5000 (host) → 3000 (container)
# Admin:    5002 (host) → 3001 (container)
# Mailpit:  8025 (UI), 1025 (SMTP)

# ── GHN SHIPPING (để trống GHN_TOKEN để dùng chế độ demo) ──
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_WEBHOOK_SECRET=demo-ghn-secret
GHN_DEMO=true

# ── UID/GID của user host (Makefile tự export, chỉ cần khi chạy docker compose trực tiếp) ──
# Lấy bằng: echo "$(id -u):$(id -g)"
PHP_UID=1000
PHP_GID=1000
