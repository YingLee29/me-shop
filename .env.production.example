# ─────────────────────────────────────────────────────
# .env.production.example
# File thật `.env.production` được Capistrano sinh tự động trên server
# (task deploy:env) với mật khẩu/APP_KEY ngẫu nhiên. Không commit file thật.
# ─────────────────────────────────────────────────────

# ── App ──
APP_NAME="Mộc Sơn"
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://example.com
FRONTEND_URL=https://example.com
ADMIN_URL=https://admin.example.com
PUBLIC_SITE_URL=https://example.com

# ── Liên hệ (floating widget) ──
NEXT_PUBLIC_ZALO_URL=https://zalo.me/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/
NEXT_PUBLIC_HOTLINE="1900 6868"

# ── Database (dùng cho cả Laravel và container mysql) ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mocson_db
DB_USERNAME=mocson_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── Redis ──
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=log

# ── Sanctum / CORS ──
SANCTUM_STATEFUL_DOMAINS=example.com,admin.example.com

# ── Filesystem ──
FILESYSTEM_DISK=public

# ── Logging ──
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Mail (đổi sang SMTP khi có) ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (tùy chọn, cho R2/S3) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
